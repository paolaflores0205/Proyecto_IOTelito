rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() {
      return signedIn() && profile().uid == request.auth.uid && profile().active == true
        && profile().role in ['CLIENT', 'HOTEL_ADMIN', 'TAXISTA', 'SUPERADMIN'];
    }
    function superadmin() { return activeUser() && profile().role == 'SUPERADMIN'; }
    function hotelAdmin(hotelId) {
      return activeUser() && profile().role == 'HOTEL_ADMIN'
        && profile().get('hotelId', null) == int(hotelId)
        && exists(/databases/$(database)/documents/hotels/$(hotelId))
        && get(/databases/$(database)/documents/hotels/$(hotelId)).data.id == int(hotelId)
        && get(/databases/$(database)/documents/hotels/$(hotelId)).data.administratorUid == request.auth.uid
        && get(/databases/$(database)/documents/hotels/$(hotelId)).data.active == true;
    }
    function validRoom(data, hotelId, roomId) {
      return data.keys().hasOnly(['id', 'hotelId', 'tipo', 'nombreCodigo', 'areaM2', 'adultos',
          'ninos', 'precioNoche', 'descripcion', 'disponible', 'archived'])
        && data.id is int && data.id > 0 && string(data.id) == roomId && data.hotelId == int(hotelId)
        && data.tipo is string && data.tipo.size() > 0 && data.tipo.size() <= 120
        && data.nombreCodigo is string && data.nombreCodigo.size() > 0 && data.nombreCodigo.size() <= 80
        && data.areaM2 is int && data.areaM2 > 0 && data.areaM2 <= 10000
        && data.adultos is int && data.adultos > 0 && data.adultos <= 100
        && data.ninos is int && data.ninos >= 0 && data.ninos <= 100
        && data.precioNoche is number && data.precioNoche >= 0 && data.precioNoche <= 1000000
        && data.descripcion is string && data.descripcion.size() <= 5000
        && data.disponible is bool && data.archived is bool
        && (data.archived == false || data.disponible == false);
    }
    function inventoryUpdate(hotelId) {
      let before = get(/databases/$(database)/documents/hotels/$(hotelId)).data;
      let after = getAfter(/databases/$(database)/documents/hotels/$(hotelId)).data;
      return after.inventoryRevision == before.get('inventoryRevision', 0) + 1 && auditUpdate(after);
    }
    function validService(data, hotelId, serviceId) {
      return data.keys().hasOnly(['id', 'hotelId', 'nombre', 'descripcion', 'precio', 'unidad', 'activo', 'archived'])
        && data.id is int && data.id > 0 && string(data.id) == serviceId && data.hotelId == int(hotelId)
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 160
        && data.descripcion is string && data.descripcion.size() <= 5000
        && data.precio is number && data.precio >= 0 && data.precio <= 1000000
        && data.unidad is string && data.unidad.size() > 0 && data.unidad.size() <= 80
        && data.activo is bool && data.archived is bool && (data.archived == false || data.activo == false);
    }
    function nextHotelId() {
      return exists(/databases/$(database)/documents/system/hotelIds)
        ? get(/databases/$(database)/documents/system/hotelIds).data.nextId : 1000000;
    }
    function validHotel(data, hotelId) {
      return data.id is int && data.id > 0 && string(data.id) == hotelId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.city is string && data.city.size() > 0 && data.city.size() <= 120
        && data.district is string && data.district.size() > 0 && data.district.size() <= 120
        && data.active is bool && data.photos is list && data.photos.size() <= 8
        && ((data.latitude is number && data.longitude is number
          && data.latitude >= -90 && data.latitude <= 90 && data.longitude >= -180 && data.longitude <= 180)
          || (data.get('dataOrigin', '') == 'LOCAL_IMPORT' && data.latitude == null && data.longitude == null));
    }
    function auditUpdate(data) { return data.updatedAt == request.time && data.updatedByUid == request.auth.uid; }
    function consistentUserHotel(uid) {
      let before = resource.data.get('hotelId', null);
      let after = request.resource.data.get('hotelId', null);
      return resource.data.role == 'HOTEL_ADMIN'
        && (after == null || (after is int && after > 0 && resource.data.active == true
          && getAfter(/databases/$(database)/documents/hotels/$(string(after))).data.administratorUid == uid))
        && (before == null || before == after
          || getAfter(/databases/$(database)/documents/hotels/$(string(before))).data.administratorUid != uid);
    }
    function consistentHotelAdmin() {
      let before = resource.data.get('administratorUid', null);
      let after = request.resource.data.get('administratorUid', null);
      return ((after == null && request.resource.data.administratorName == null)
        || (after is string && getAfter(/databases/$(database)/documents/users/$(after)).data.uid == after
          && getAfter(/databases/$(database)/documents/users/$(after)).data.role == 'HOTEL_ADMIN'
          && getAfter(/databases/$(database)/documents/users/$(after)).data.active == true
          && getAfter(/databases/$(database)/documents/users/$(after)).data.hotelId == resource.data.id
          && request.resource.data.administratorName == getAfter(/databases/$(database)/documents/users/$(after)).data.name))
        && (before == null || before == after || !exists(/databases/$(database)/documents/users/$(before))
          || getAfter(/databases/$(database)/documents/users/$(before)).data.hotelId == null);
    }

    match /users/{uid} {
      // El perfil propio debe poder leerse para informar que la cuenta está inactiva.
      allow get: if signedIn() && (request.auth.uid == uid || superadmin());
      allow list: if superadmin();
      // Ningún registro público puede crear roles administrativos ni asignarse hotel.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'firstNames', 'lastNames',
          'documentType', 'documentNumber', 'birthDate', 'phone', 'address', 'photoUrl',
          'role', 'active', 'hotelId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.role == 'CLIENT'
        && request.resource.data.active == true
        && request.resource.data.get('hotelId', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        (request.auth.uid == uid && activeUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'firstNames', 'lastNames', 'documentType', 'documentNumber', 'birthDate',
            'phone', 'address', 'photoUrl', 'updatedAt', 'lastAccessAt'])
          && request.resource.data.updatedAt == request.time)
        || (superadmin() && request.auth.uid != uid && resource.data.role != 'SUPERADMIN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'active', 'statusReason', 'updatedAt', 'updatedByUid'])
          && request.resource.data.active is bool
          && request.resource.data.statusReason is string
          && request.resource.data.statusReason.size() <= 500
          && (request.resource.data.active == true || request.resource.data.statusReason.size() > 0)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedByUid == request.auth.uid)
        || (superadmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hotelId', 'updatedAt', 'updatedByUid'])
          && auditUpdate(request.resource.data) && consistentUserHotel(uid))
      );
      allow delete: if false;
    }

    match /hotels/{hotelId} {
      allow read: if activeUser();
      allow create: if superadmin() && validHotel(request.resource.data, hotelId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'address', 'district', 'city', 'phone', 'email',
          'description', 'active', 'latitude', 'longitude', 'photos', 'administratorUid', 'administratorName',
          'rooms', 'reservations', 'hasInventory', 'pricePerNight', 'rating', 'reviews', 'services', 'attractions',
          'dataOrigin', 'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'])
        && request.resource.data.administratorUid == null && request.resource.data.administratorName == null
        && request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid
        && auditUpdate(request.resource.data)
        && ((request.resource.data.dataOrigin == 'LOCAL_IMPORT' && request.resource.data.id < 1000000)
          || (request.resource.data.dataOrigin == 'APP' && request.resource.data.id >= 1000000
            && request.resource.data.id == nextHotelId()
            && getAfter(/databases/$(database)/documents/system/hotelIds).data.nextId == request.resource.data.id + 1
            && getAfter(/databases/$(database)/documents/system/hotelIds).data.updatedAt == request.time));
      allow update: if superadmin() && auditUpdate(request.resource.data) && (
        (validHotel(request.resource.data, hotelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'district', 'city',
            'phone', 'email', 'description', 'active', 'latitude', 'longitude', 'photos', 'updatedAt', 'updatedByUid']))
        || (request.resource.data.active is bool
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt', 'updatedByUid']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'administratorUid', 'administratorName', 'updatedAt', 'updatedByUid']) && consistentHotelAdmin())
      );
      allow delete: if false;

      match /rooms/{roomId} {
        allow read: if activeUser();
        allow create: if superadmin() && request.resource.data.id is int && request.resource.data.id > 0
          && string(request.resource.data.id) == roomId && request.resource.data.hotelId == int(hotelId)
          && getAfter(/databases/$(database)/documents/hotels/$(hotelId)).data.id == int(hotelId)
          && request.resource.data.keys().hasOnly(['id', 'hotelId', 'tipo', 'nombreCodigo', 'areaM2', 'adultos',
            'ninos', 'precioNoche', 'descripcion', 'disponible'])
          && request.resource.data.tipo is string && request.resource.data.nombreCodigo is string
          && request.resource.data.areaM2 is int && request.resource.data.areaM2 > 0
          && request.resource.data.adultos is int && request.resource.data.adultos > 0
          && request.resource.data.ninos is int && request.resource.data.ninos >= 0
          && request.resource.data.precioNoche is number && request.resource.data.precioNoche >= 0
          && request.resource.data.descripcion is string && request.resource.data.disponible is bool;
        allow update, delete: if false;
        allow create: if hotelAdmin(hotelId) && inventoryUpdate(hotelId)
          && validRoom(request.resource.data, hotelId, roomId) && request.resource.data.archived == false;
        allow update: if hotelAdmin(hotelId) && inventoryUpdate(hotelId)
          && resource.data.get('archived', false) == false && validRoom(request.resource.data, hotelId, roomId)
          && request.resource.data.id == resource.data.id && request.resource.data.hotelId == resource.data.hotelId;
      }
      allow update: if hotelAdmin(hotelId) && auditUpdate(request.resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'address', 'description', 'attractions', 'phone', 'email', 'updatedAt', 'updatedByUid'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
          && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 500
          && request.resource.data.description is string && request.resource.data.description.size() <= 5000
          && request.resource.data.attractions is string && request.resource.data.attractions.size() <= 5000
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 80
          && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rooms', 'hasInventory', 'pricePerNight', 'inventoryRevision', 'updatedAt', 'updatedByUid'])
          && request.resource.data.inventoryRevision is int
          && request.resource.data.inventoryRevision == resource.data.get('inventoryRevision', 0) + 1
          && request.resource.data.rooms is int && request.resource.data.rooms >= 0
          && request.resource.data.hasInventory is bool && request.resource.data.pricePerNight is number
          && request.resource.data.pricePerNight >= 0 && request.resource.data.pricePerNight <= 1000000)
      );
      match /services/{serviceId} {
        allow read: if activeUser();
        allow create: if hotelAdmin(hotelId) && validService(request.resource.data, hotelId, serviceId)
          && request.resource.data.archived == false;
        allow update: if hotelAdmin(hotelId) && resource.data.get('archived', false) == false
          && validService(request.resource.data, hotelId, serviceId)
          && request.resource.data.id == resource.data.id && request.resource.data.hotelId == resource.data.hotelId;
        allow delete: if false;
      }
    }

    match /system/hotelIds {
      allow get: if superadmin();
      allow create, update: if superadmin()
        && request.resource.data.keys().hasOnly(['nextId', 'updatedAt', 'updatedByUid'])
        && request.resource.data.nextId is int && request.resource.data.nextId > 1000000
        && request.resource.data.nextId <= 2147483647 && request.resource.data.nextId == nextHotelId() + 1
        && auditUpdate(request.resource.data)
        && !exists(/databases/$(database)/documents/hotels/$(string(nextHotelId())))
        && getAfter(/databases/$(database)/documents/hotels/$(string(nextHotelId()))).data.id == nextHotelId();
      allow list, delete: if false;
    }

    match /reservations/{reservationId} {
      allow get: if activeUser()
        && (superadmin() || resource == null || resource.data.clientUid == request.auth.uid
          || hotelAdmin(string(resource.data.hotelId)));
      allow list: if activeUser()
        && (superadmin() || resource.data.clientUid == request.auth.uid || hotelAdmin(string(resource.data.hotelId)));
      allow create: if activeUser() && profile().role == 'CLIENT'
        && get(/databases/$(database)/documents/hotels/$(string(request.resource.data.hotelId))).data.active == true
        && get(/databases/$(database)/documents/hotels/$(string(request.resource.data.hotelId))).data.hasInventory == true
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.estado == 'CONFIRMADA'
        && request.resource.data.roomIds is list
        && request.resource.data.roomIds.size() > 0
        && request.resource.data.fechaEntrada is string
        && request.resource.data.fechaSalida is string
        && request.resource.data.fechaEntrada < request.resource.data.fechaSalida;
      allow update: if activeUser()
        && resource.data.clientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && resource.data.estado == 'CONFIRMADA'
        && request.resource.data.estado == 'COMPLETADA';
      // Cierre administrativo: solo el estado, junto con un comprobante inmutable.
      allow update: if hotelAdmin(string(resource.data.hotelId))
        && resource.data.estado == 'CONFIRMADA' && request.resource.data.estado == 'COMPLETADA'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && !exists(/databases/$(database)/documents/hotelCheckouts/$(reservationId))
        && getAfter(/databases/$(database)/documents/hotelCheckouts/$(reservationId)).data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/hotelCheckouts/$(reservationId)).data.createdAt == request.time;
      allow delete: if false;
      match /messages/{messageId} {
        function participant() {
          let booking = get(/databases/$(database)/documents/reservations/$(reservationId)).data;
          return activeUser() && ((profile().role == 'CLIENT' && booking.clientUid == request.auth.uid)
            || hotelAdmin(string(booking.hotelId)));
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['senderUid','senderRole','text','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderRole == profile().role
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /hotelCheckouts/{reservationId} {
      function booking() { return get(/databases/$(database)/documents/reservations/$(reservationId)).data; }
      function departureReached() {
        let parts = booking().fechaSalida.split('-');
        return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) + duration.value(5, 'h') <= request.time;
      }
      // get permite comprobar que el comprobante aún no existe dentro de la transacción.
      allow get: if activeUser() && (superadmin() || booking().clientUid == request.auth.uid
        || hotelAdmin(string(booking().hotelId)));
      allow list: if activeUser() && (superadmin() || resource.data.clientUid == request.auth.uid
        || hotelAdmin(string(resource.data.hotelId)));
      allow create: if hotelAdmin(string(booking().hotelId)) && departureReached()
        && booking().estado == 'CONFIRMADA'
        && getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.estado == 'COMPLETADA'
        && request.resource.data.keys().hasOnly(['reservationId','hotelId','clientUid','base','extra','total','reason','observation','createdAt','createdByUid'])
        && request.resource.data.reservationId == reservationId
        && request.resource.data.hotelId == booking().hotelId && request.resource.data.clientUid == booking().clientUid
        && request.resource.data.base == booking().precioTotal && request.resource.data.base is number && request.resource.data.base >= 0
        && request.resource.data.extra is number && request.resource.data.extra >= 0 && request.resource.data.extra <= 1000000
        && request.resource.data.total == request.resource.data.base + request.resource.data.extra
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.observation is string && request.resource.data.observation.size() <= 4000
        && (request.resource.data.extra == 0 || (request.resource.data.reason.size() > 0 && request.resource.data.observation.size() > 0))
        && request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /clientNights/{nightId} {
      allow get: if activeUser()
        && nightId.matches(request.auth.uid + '_.*');
      allow list: if false;
      allow create: if activeUser() && profile().role == 'CLIENT'
        && nightId.matches(request.auth.uid + '_.*')
        && request.resource.data.clientUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
             .data.clientUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /roomNights/{nightId} {
      allow get: if activeUser();
      allow list: if false;
      allow create: if activeUser() && profile().role == 'CLIENT'
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
             .data.clientUid == request.auth.uid;
      allow update, delete: if false;
    }


    match /logs/{logId} {
      allow read: if superadmin();
      allow create: if superadmin()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorRole', 'action', 'entityType', 'entityId', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.actorRole == 'SUPERADMIN'
        && request.resource.data.createdAt == request.time
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0 && request.resource.data.entityId.size() <= 128
        && ((request.resource.data.entityType == 'hotels'
          && request.resource.data.action in ['HOTEL_CREATED', 'HOTEL_UPDATED', 'HOTEL_ACTIVATED', 'HOTEL_DEACTIVATED', 'HOTEL_IMPORTED', 'HOTEL_ADMIN_ASSIGNED', 'HOTEL_ADMIN_REMOVED'])
          || (request.resource.data.entityType == 'users' && request.resource.data.action in ['USER_ACTIVATED', 'USER_DEACTIVATED']))
        && getAfter(/databases/$(database)/documents/$(request.resource.data.entityType)/$(request.resource.data.entityId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/$(request.resource.data.entityType)/$(request.resource.data.entityId)).data.updatedByUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /taxistas/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.activo == true
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['disponible'])
        && request.resource.data.disponible is bool;
    }
    // Integración de taxi: estos permisos solo se aplican a las colecciones nuevas.
    function taxiDriver() {
      return request.auth != null
        && exists(/databases/$(database)/documents/taxistas/$(request.auth.uid))
        && get(/databases/$(database)/documents/taxistas/$(request.auth.uid)).data.activo == true;
    }

    match /taxiRequests/{requestId} {
      function ownsReservation() {
        return exists(/databases/$(database)/documents/reservations/$(requestId))
          && get(/databases/$(database)/documents/reservations/$(requestId)).data.clientUid == request.auth.uid;
      }
      function driverLockAfter() {
        return getAfter(/databases/$(database)/documents/taxiDrivers/$(request.auth.uid)).data.activeRequestId;
      }
      allow get: if request.auth != null && (
        (resource == null && (ownsReservation() || taxiDriver()))
        || (resource != null && (resource.data.clientUid == request.auth.uid
          || (taxiDriver() && (resource.data.estado == 'SOLICITADO'
            || resource.data.taxistaUid == request.auth.uid)))));
      allow list: if request.auth != null && (resource.data.clientUid == request.auth.uid
        || (taxiDriver() && (resource.data.estado == 'SOLICITADO'
          || resource.data.taxistaUid == request.auth.uid)));
      allow create: if request.auth != null && ownsReservation()
        && request.resource.data.keys().hasOnly(['id','reserva','clientUid','cliente','nombre','hotel',
             'origen','destino','hora','pasajeros','maletas','estado','creado','taxistaUid','taxista','conductor','finalizado'])
        && request.resource.data.id is int && request.resource.data.id > 0
        && requestId == string(request.resource.data.id)
        && request.resource.data.reserva == request.resource.data.id
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.cliente == request.auth.token.email
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0
        && request.resource.data.hotel is string && request.resource.data.origen is string
        && request.resource.data.destino == 'Aeropuerto Jorge Chávez'
        && request.resource.data.hora is string
        && request.resource.data.hora.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && request.resource.data.pasajeros is int && request.resource.data.pasajeros >= 1
        && request.resource.data.maletas is int && request.resource.data.maletas >= 0
        && request.resource.data.estado == 'SOLICITADO'
        && request.resource.data.taxistaUid == '' && request.resource.data.taxista == ''
        && request.resource.data.conductor == '' && request.resource.data.finalizado == null
        && request.resource.data.creado == request.time;
      allow update: if taxiDriver() && (
        (resource.data.estado == 'SOLICITADO' && resource.data.taxistaUid == ''
          && request.resource.data.estado == 'ASIGNADO'
          && get(/databases/$(database)/documents/taxistas/$(request.auth.uid)).data.disponible == true
          && request.resource.data.taxistaUid == request.auth.uid
          && request.resource.data.taxista == request.auth.token.email
          && request.resource.data.conductor is string && request.resource.data.conductor.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','taxistaUid','taxista','conductor'])
          && driverLockAfter() == requestId)
        || (resource.data.taxistaUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && ((resource.data.estado == 'ASIGNADO' && request.resource.data.estado == 'EN_CAMINO')
            || (resource.data.estado == 'EN_CAMINO' && request.resource.data.estado == 'EN_TRASLADO'))
          && driverLockAfter() == requestId)
        || (resource.data.taxistaUid == request.auth.uid && resource.data.estado == 'EN_TRASLADO'
          && request.resource.data.estado == 'FINALIZADO'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','finalizado'])
          && request.resource.data.finalizado == request.time && driverLockAfter() == ''));
      allow delete: if false;
    }

    match /taxiDrivers/{uid} {
      function validLock() {
        let id = request.resource.data.activeRequestId;
        return request.resource.data.keys().hasOnly(['activeRequestId']) && id is string
          && ((id != ''
              && (!exists(/databases/$(database)/documents/taxiDrivers/$(uid))
                  || resource.data.activeRequestId == '')
              && getAfter(/databases/$(database)/documents/taxiRequests/$(id)).data.estado == 'ASIGNADO'
              && getAfter(/databases/$(database)/documents/taxiRequests/$(id)).data.taxistaUid == uid)
            || (id == '' && resource != null && resource.data.activeRequestId != ''
              && getAfter(/databases/$(database)/documents/taxiRequests/$(resource.data.activeRequestId)).data.estado == 'FINALIZADO'
              && getAfter(/databases/$(database)/documents/taxiRequests/$(resource.data.activeRequestId)).data.taxistaUid == uid));
      }
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if taxiDriver() && request.auth.uid == uid && validLock();
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
