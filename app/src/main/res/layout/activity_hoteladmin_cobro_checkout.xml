<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical"
    tools:context=".ui.hoteladmin.reservas.CobroCheckoutActivity">

    <include android:id="@+id/toolbar" layout="@layout/item_hoteladmin_toolbar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:strokeColor="@color/io_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hoteladmin_datos_reserva" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_huesped" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Alejandro Quispe Mendoza" />
                    <TextView android:id="@+id/tv_documento" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="DNI 45678910" />
                    <TextView android:id="@+id/tv_habitacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/io_text_secondary" android:textSize="14sp" tools:text="Suite Ejecutiva · Hab. 402" />
                    <TextView android:id="@+id/tv_fechas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/io_text_secondary" android:textSize="14sp" tools:text="15 – 18 set · 3 noches" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:strokeColor="@color/io_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hoteladmin_detalle_cobro" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hoteladmin_alojamiento" android:textColor="@color/io_text_secondary" android:textSize="14sp" />
                        <TextView android:id="@+id/tv_alojamiento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/io_text_primary" android:textSize="14sp" android:textStyle="bold" tools:text="S/ 1,350.00" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/hoteladmin_servicios_consumidos" android:textColor="@color/io_text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_sin_consumos" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp" android:text="@string/hoteladmin_sin_consumos" android:textColor="@color/io_text_muted" android:textSize="13sp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/ll_consumos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/io_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hoteladmin_subtotal" android:textColor="@color/io_text_primary" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_subtotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/io_text_primary" android:textSize="15sp" android:textStyle="bold" tools:text="S/ 1,600.00" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_danos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hoteladmin_agregar_cobro_danos"
                android:textColor="@color/io_text_primary"
                android:textStyle="bold" />

            <LinearLayout android:id="@+id/ll_danos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/TextAppearance.IoTelito.FieldLabel" android:layout_marginTop="8dp" android:text="@string/hoteladmin_monto_dano" />
                <EditText android:id="@+id/et_monto_dano" style="@style/Widget.IoTelito.FieldInput" android:hint="@string/hoteladmin_monto_dano_hint" android:inputType="numberDecimal" />
                <TextView style="@style/TextAppearance.IoTelito.FieldLabel" android:layout_marginTop="10dp" android:text="@string/hoteladmin_motivo_dano" />
                <EditText android:id="@+id/et_motivo_dano" style="@style/Widget.IoTelito.FieldInput" android:hint="@string/hoteladmin_motivo_dano_hint" android:inputType="textCapSentences" />
                <TextView style="@style/TextAppearance.IoTelito.FieldLabel" android:layout_marginTop="10dp" android:text="@string/hoteladmin_observacion_dano" />
                <EditText android:id="@+id/et_observacion_dano" style="@style/Widget.IoTelito.FieldInput" android:gravity="top" android:hint="@string/hoteladmin_observacion_dano_hint" android:inputType="textCapSentences|textMultiLine" android:minLines="3" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/io_navy">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hoteladmin_total_final" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/io_teal" android:textSize="22sp" android:textStyle="bold" tools:text="S/ 1,600.00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tv_aviso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_info_box_teal" android:drawablePadding="7dp" android:padding="12dp" android:text="@string/hoteladmin_aviso_notificacion_cobro" android:textColor="@color/io_text_secondary" android:textSize="12sp" app:drawableStartCompat="@drawable/ic_info_outline" app:drawableTint="@color/io_teal" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirmar" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:text="@string/hoteladmin_confirmar_checkout" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
