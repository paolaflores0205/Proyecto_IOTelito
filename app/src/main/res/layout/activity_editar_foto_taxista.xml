<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical"
    tools:context=".ui.taxista.EditarFotoTaxistaActivity">

    <include
        android:id="@+id/sub_header"
        layout="@layout/item_sub_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/tv_avatar_inicial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="MA" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_stepper_button">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/io_teal"
                    android:contentDescription="@null" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/io_text_secondary"
            android:textSize="13sp"
            android:text="@string/taxi_editar_foto_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cambiar_foto"
            style="@style/Widget.IoTelito.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="@string/taxi_btn_cambiar_foto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quitar_foto"
            style="@style/Widget.IoTelito.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            app:strokeColor="@color/io_danger_text"
            android:textColor="@color/io_danger_text"
            android:text="@string/taxi_btn_quitar_foto" />

    </LinearLayout>
</LinearLayout>
