<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/ayuda_tarjeta_prueba" android:textColor="@color/io_text_secondary" />
    <EditText android:id="@+id/et_numero_tarjeta" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:hint="@string/numero_tarjeta" android:inputType="number"
        android:saveEnabled="false" android:maxLength="19" android:singleLine="true" android:imeOptions="actionNext" />
    <EditText android:id="@+id/et_vencimiento" android:layout_width="match_parent" android:layout_height="56dp"
        android:hint="Vencimiento MM/AA" android:inputType="datetime" android:digits="0123456789/"
        android:maxLength="5" android:singleLine="true" android:imeOptions="actionNext" />
    <EditText android:id="@+id/et_cvv" android:layout_width="match_parent" android:layout_height="56dp"
        android:hint="CVV de prueba" android:inputType="numberPassword" android:maxLength="4"
        android:saveEnabled="false" android:singleLine="true" android:imeOptions="actionDone" />
    <TextView android:id="@+id/tv_error_tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:textColor="@color/io_danger_text" android:visibility="gone" />
</LinearLayout>
