<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/io_surface_variant" android:orientation="vertical"
    tools:context=".ui.superadmin.hoteles.DetalleHotelAdminActivity">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/io_surface" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/superadmin_hotel_detail_title" app:titleTextColor="@color/io_navy" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/iv_hero" android:layout_width="match_parent" android:layout_height="190dp" android:contentDescription="@string/superadmin_cd_hotel_photo" android:scaleType="centerCrop" android:src="@drawable/superadmin_hotel_hero" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tv_hotel_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_navy" android:textSize="22sp" android:textStyle="bold" tools:text="Hotel Sol de Miraflores" />
                <TextView android:id="@+id/tv_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:drawableStart="@drawable/ic_location_pin" android:drawablePadding="8dp" android:textColor="@color/io_text_secondary" app:drawableTint="@color/io_teal" tools:text="Av. Larco 345, Miraflores, Lima" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/superadmin_contact_information" android:textColor="@color/io_navy" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+51 1 445 6210" android:textColor="@color/io_text_primary"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="contacto@hotelsol.pe" android:textColor="@color/io_text_primary"/></LinearLayout></com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/superadmin_assigned_admin" android:textColor="@color/io_navy" android:textStyle="bold" />
                <TextView android:id="@+id/tv_admin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/io_surface" android:drawableStart="@drawable/ic_person" android:drawablePadding="10dp" android:padding="14dp" android:textColor="@color/io_text_primary" android:textStyle="bold" app:drawableTint="@color/io_teal" tools:text="Juan Carlos Huamán" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tv_rooms" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@color/io_surface" android:gravity="center" android:textColor="@color/io_navy" android:textStyle="bold" tools:text="24\nHabitaciones" />
                    <TextView android:layout_width="0dp" android:layout_height="72dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@color/io_surface" android:gravity="center" android:text="S/ 42.8k\nIngresos mes" android:textColor="@color/io_navy" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@color/io_surface" android:gravity="center" android:text="78%\nOcupación prom." android:textColor="@color/io_navy" android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_iot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:checked="true" android:text="@string/superadmin_iot_operations" android:textColor="@color/io_navy" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/superadmin_iot_operations_subtitle" android:textColor="@color/io_text_secondary" android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/superadmin_edit_hotel" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_change_admin" style="@style/Widget.IoTelito.Button.Outline" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="@string/superadmin_change_admin" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
