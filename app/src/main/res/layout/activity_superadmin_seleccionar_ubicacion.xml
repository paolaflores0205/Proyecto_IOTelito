<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_surface_variant"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/io_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/superadmin_location_picker_title"
        app:titleTextColor="@color/io_navy" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/map_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/superadmin_location_picker_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/superadmin_location_picker_instruction"
                android:textColor="@color/io_navy"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:layout_marginBottom="26dp"
            android:contentDescription="@string/superadmin_location_picker_title"
            android:elevation="8dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/io_teal" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/io_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_selected_coordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/superadmin_location_picker_loading"
            android:textColor="@color/io_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_location"
            style="@style/Widget.IoTelito.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/superadmin_location_picker_confirm"
            app:icon="@drawable/ic_location_pin" />
    </LinearLayout>
</LinearLayout>
