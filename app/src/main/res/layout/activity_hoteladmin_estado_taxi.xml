<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical"
    tools:context=".ui.hoteladmin.reservas.EstadoTaxiActivity">

    <include android:id="@+id/toolbar" layout="@layout/item_hoteladmin_toolbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:strokeColor="@color/io_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hoteladmin_taxi_traslado" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_huesped" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Alejandro Quispe Mendoza" />
                    <TextView android:id="@+id/tv_habitacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="Suite Ejecutiva · Hab. 402" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/hoteladmin_taxi_destino" android:textColor="@color/io_text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_destino" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_primary" android:textSize="14sp" android:textStyle="bold" tools:text="Aeropuerto Internacional Jorge Chávez" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:strokeColor="@color/io_divider" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <com.google.android.material.imageview.ShapeableImageView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_teal_light" android:contentDescription="@string/hoteladmin_taxi_foto_conductor" android:padding="16dp" android:scaleType="centerInside" android:src="@drawable/ic_person" android:tint="@color/io_teal" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.IoTelito.Circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hoteladmin_taxi_conductor" android:textColor="@color/io_text_muted" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_conductor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Mateo Quispe Huamán" />
                        <TextView android:id="@+id/tv_rating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/io_warning_text" android:textSize="13sp" tools:text="★ 4.8" />
                        <TextView android:id="@+id/tv_vehiculo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="Toyota Corolla · Gris" />
                        <TextView android:id="@+id/tv_placa" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="ABC-123" />
                        <TextView android:id="@+id/tv_telefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="+51 987 112 334" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/hoteladmin_taxi_mapa"
                android:scaleType="centerCrop"
                android:src="@drawable/hoteladmin_map_miraflores"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.IoTelito.Rounded8" />

            <TextView android:id="@+id/tv_estado_actual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Estado actual: En camino" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="5">
                <TextView android:id="@+id/tv_solicitado" style="@style/HotelAdminTaxiStep" android:text="@string/hoteladmin_taxi_solicitado" />
                <TextView android:id="@+id/tv_asignado" style="@style/HotelAdminTaxiStep" android:text="@string/hoteladmin_taxi_asignado" />
                <TextView android:id="@+id/tv_en_camino" style="@style/HotelAdminTaxiStep" android:text="@string/hoteladmin_taxi_en_camino" />
                <TextView android:id="@+id/tv_en_traslado" style="@style/HotelAdminTaxiStep" android:text="@string/hoteladmin_taxi_en_traslado" />
                <TextView android:id="@+id/tv_finalizado" style="@style/HotelAdminTaxiStep" android:text="@string/hoteladmin_taxi_finalizado" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_contactar" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:text="@string/hoteladmin_taxi_contactar" app:icon="@drawable/ic_phone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_ver_reserva" style="@style/Widget.IoTelito.Button.Outline" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="@string/hoteladmin_ver_reserva" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
