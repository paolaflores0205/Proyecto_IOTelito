<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical">

    <include
        android:id="@+id/sub_header"
        layout="@layout/item_sub_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar_upload">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/io_text_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/register_add_photo"
                    android:textColor="@color/io_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="12dp"
                android:text="@string/register_names"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_names_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_names_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_names_hint"
                    android:inputType="textPersonName"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_lastnames"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_lastnames_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_lastnames_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_lastnames_hint"
                    android:inputType="textPersonName"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_document_type"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_document_type_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconDrawable="@drawable/ic_chevron_down"
                app:endIconMode="custom"
                app:endIconTint="@color/io_teal"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_document_type_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@string/register_document_default"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_document_number"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_document_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_document_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_document_hint"
                    android:inputType="number"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_birthdate"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_birthdate_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_birthdate_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_birthdate_hint"
                    android:inputType="date"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/login_email"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_email_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_email_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/login_email_hint"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_phone"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_phone_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_phone_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_phone_hint"
                    android:inputType="phone"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.IoTelito.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/register_address"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/register_address_layout"
                style="@style/Widget.IoTelito.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/register_address_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/register_address_hint"
                    android:inputType="textPostalAddress"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_registrarme"
                style="@style/Widget.IoTelito.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/register_button" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
