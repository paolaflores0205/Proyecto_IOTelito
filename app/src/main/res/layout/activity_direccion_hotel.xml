<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical"
    tools:context=".ui.taxista.DireccionHotelActivity">

    <include
        android:id="@+id/sub_header"
        layout="@layout/item_sub_header_estado" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/io_text_primary"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/io_teal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:text="@string/taxi_direccion_al_hotel" />

        <TextView
            android:id="@+id/tv_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Av. Malecón de la Reserva 1035" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_map_placeholder">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:background="#20000000" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#20000000" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/ic_taxi"
            android:tint="@color/io_teal"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_marginStart="26dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_location_pin"
            android:tint="@color/io_warning_text"
            android:contentDescription="@null" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_instruccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/io_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Gira a la derecha en 30m" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_tiempo_distancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/io_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="12 min · 4.2 km" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_llegue_al_hotel"
        style="@style/Widget.IoTelito.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="@string/taxi_btn_llegue_al_hotel" />

</LinearLayout>
