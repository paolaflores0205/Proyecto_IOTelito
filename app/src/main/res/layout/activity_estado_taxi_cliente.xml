<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/io_background">
    <TextView android:id="@+id/tv_estado_taxi_cliente"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/io_teal"
        android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/tv_detalle_taxi_cliente"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textSize="18sp" android:textColor="@color/io_text_primary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_volver_taxi"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/taxi_volver" />
</LinearLayout>
