<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/io_background">

    <include android:id="@+id/sub_header" layout="@layout/item_sub_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/io_navy"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_estado_taxi_cliente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_info_box_teal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/io_teal"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:accessibilityLiveRegion="polite" />

                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="10dp"
                            android:background="@drawable/bg_info_box_teal"
                            android:src="@drawable/ic_taxi"
                            android:contentDescription="@null"
                            app:tint="@color/io_teal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_taxi_titular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/taxi_hero_solicitado"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_taxi_descripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/taxi_desc_solicitado"
                        android:textColor="@color/io_border"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_taxi_folio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:textColor="@color/io_teal"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.IoTelito.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView style="@style/TextAppearance.IoTelito.SectionTitle"
                        android:text="@string/taxi_seguimiento_progreso" android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/tv_taxi_paso_solicitado"
                            style="@style/TaxiTrackingStep" android:text="@string/cliente_taxi_estado_solicitado" />
                        <TextView android:id="@+id/tv_taxi_paso_asignado"
                            style="@style/TaxiTrackingStep" android:text="@string/cliente_taxi_estado_asignado" />
                        <TextView android:id="@+id/tv_taxi_paso_camino"
                            style="@style/TaxiTrackingStep" android:text="@string/taxi_estado_camino" />
                        <TextView android:id="@+id/tv_taxi_paso_finalizado"
                            style="@style/TaxiTrackingStep" android:text="@string/cliente_taxi_estado_finalizado" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.IoTelito.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView style="@style/TextAppearance.IoTelito.SectionTitle"
                        android:text="@string/taxi_seguimiento_ruta" android:textSize="16sp" />

                    <TextView style="@style/TaxiTrackingLabel"
                        android:layout_marginTop="18dp" android:text="@string/taxi_seguimiento_origen" />
                    <TextView android:id="@+id/tv_taxi_hotel" style="@style/TaxiTrackingValue" />
                    <TextView android:id="@+id/tv_taxi_origen" style="@style/TaxiTrackingLabel"
                        android:layout_marginTop="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="16dp" android:background="@color/io_divider" />

                    <TextView style="@style/TaxiTrackingLabel" android:text="@string/taxi_seguimiento_destino" />
                    <TextView android:id="@+id/tv_taxi_destino" style="@style/TaxiTrackingValue" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="16dp" android:background="@color/io_divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:baselineAligned="false" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.4" android:orientation="vertical">
                            <TextView style="@style/TaxiTrackingLabel" android:text="@string/taxi_seguimiento_hora" />
                            <TextView android:id="@+id/tv_taxi_hora" style="@style/TaxiTrackingValue" android:textSize="20sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/TaxiTrackingLabel" android:text="@string/taxi_seguimiento_pasajeros" />
                            <TextView android:id="@+id/tv_taxi_pasajeros" style="@style/TaxiTrackingValue" android:textSize="20sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="0.8" android:orientation="vertical">
                            <TextView style="@style/TaxiTrackingLabel" android:text="@string/taxi_seguimiento_maletas" />
                            <TextView android:id="@+id/tv_taxi_maletas" style="@style/TaxiTrackingValue" android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_taxi_conductor"
                style="@style/Widget.IoTelito.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/TaxiTrackingLabel" android:text="@string/taxi_seguimiento_conductor" />
                    <TextView android:id="@+id/tv_taxi_conductor" style="@style/TaxiTrackingValue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tv_taxi_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_box_teal"
                android:padding="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/taxi_seguimiento_aviso"
                android:textColor="@color/io_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver_taxi"
            style="@style/Widget.IoTelito.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/taxi_seguimiento_volver" />
    </LinearLayout>
</LinearLayout>
