<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_opcion_foto"
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/superadmin_hotel_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_opcion_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/io_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Combinación de 2 habitaciones" />

            <TextView
                android:id="@+id/tv_opcion_habitaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/io_text_secondary"
                android:textSize="13sp"
                tools:text="Suite Ejecutiva + Suite Deluxe" />

            <TextView
                android:id="@+id/tv_opcion_capacidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tag_gray"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/io_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="4 adultos, 3 niños · 2 habitaciones" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_opcion_precio_noche"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/io_teal"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="S/ 1,070 / noche" />

                <TextView
                    android:id="@+id/tv_opcion_precio_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/io_text_secondary"
                    android:textSize="12sp"
                    tools:text="S/ 3,210 por 3 noches" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_opcion"
                style="@style/Widget.IoTelito.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:text="@string/ver_detalle_habitaciones"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
