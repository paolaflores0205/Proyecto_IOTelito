<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/io_surface_variant" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView style="@style/TextAppearance.IoTelito.SectionTitle" android:text="Reportes de hoteles"/>
  <TextView android:id="@+id/tv_report_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preparando historial local de demostración…" android:textColor="@color/io_text_secondary" android:textSize="12sp"/>
  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_demo_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Incluir historial de demostración" android:textColor="@color/io_navy"/>
  <com.google.android.material.textfield.TextInputLayout style="@style/Widget.IoTelito.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Hotel" app:endIconMode="dropdown_menu">
   <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actv_hotel_selector" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"/>
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_period" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
   <com.google.android.material.chip.Chip android:id="@+id/chip_daily" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:checked="false" android:text="Diario"/>
   <com.google.android.material.chip.Chip android:id="@+id/chip_monthly" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:checked="true" android:text="Mensual"/>
   <com.google.android.material.chip.Chip android:id="@+id/chip_yearly" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:checked="false" android:text="Anual"/>
  </com.google.android.material.chip.ChipGroup>
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_report_date" style="@style/Widget.IoTelito.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elegir fecha"/>
  <TextView android:id="@+id/tv_selected_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
   <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="114dp" android:padding="12dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reservas con llegada" android:textColor="@color/io_text_secondary" android:textSize="12sp"/>
    <TextView android:id="@+id/tv_bookings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="@color/io_navy" android:textSize="23sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_bookings_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="11sp"/>
   </LinearLayout></com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="114dp" android:padding="12dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancelaciones" android:textColor="@color/io_text_secondary" android:textSize="12sp"/>
    <TextView android:id="@+id/tv_cancellations" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="@color/io_navy" android:textSize="23sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_cancellations_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="11sp"/>
   </LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
   <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="114dp" android:padding="12dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ocupación estimada" android:textColor="@color/io_text_secondary" android:textSize="12sp"/>
    <TextView android:id="@+id/tv_occupancy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="@color/io_navy" android:textSize="23sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_occupancy_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="11sp"/>
   </LinearLayout></com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="114dp" android:padding="12dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Importe de estadías" android:textColor="@color/io_text_secondary" android:textSize="12sp"/>
    <TextView android:id="@+id/tv_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="@color/io_navy" android:textSize="23sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_income_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/io_text_secondary" android:textSize="11sp"/>
   </LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout>
  <TextView android:id="@+id/tv_chart_title" style="@style/TextAppearance.IoTelito.SectionTitle" android:layout_marginTop="20dp" android:text="Reservas del mes"/>
  <TextView android:id="@+id/tv_report_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin reservas para este filtro y período." android:textColor="@color/io_text_secondary"/>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="250dp" android:fillViewport="true"><com.example.proyecto_iotelito.ui.superadmin.reportes.WeeklyBookingsChartView android:id="@+id/weekly_bookings_chart" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/io_surface" android:padding="12dp"/></HorizontalScrollView>
  <TextView style="@style/TextAppearance.IoTelito.SectionTitle" android:layout_marginTop="20dp" android:text="Ranking de ocupación"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Noches-habitación reservadas / capacidad del período. Salida no incluida. Sin inventario: no calculable." android:textSize="11sp" android:textColor="@color/io_text_secondary"/>
  <LinearLayout android:id="@+id/ranking_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@color/io_surface"/>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
