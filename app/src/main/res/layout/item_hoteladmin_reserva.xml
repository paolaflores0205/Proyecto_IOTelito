<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.IoTelito.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:strokeColor="@color/io_divider"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_huesped" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/io_text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Alejandro Quispe Mendoza" />
            <TextView android:id="@+id/tv_estado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill" android:paddingHorizontal="9dp" android:paddingVertical="4dp" android:textSize="11sp" android:textStyle="bold" tools:text="Checkout pendiente" />
        </LinearLayout>
        <TextView android:id="@+id/tv_habitacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/io_text_secondary" android:textSize="14sp" tools:text="Suite Ejecutiva · Hab. 402" />
        <TextView android:id="@+id/tv_fechas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/io_text_secondary" android:textSize="13sp" tools:text="15 – 18 set · 3 noches" />
        <TextView android:id="@+id/tv_alerta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_warning_box" android:drawablePadding="6dp" android:padding="9dp" android:text="@string/hoteladmin_alerta_checkout" android:textColor="@color/io_warning_text" android:textSize="12sp" android:textStyle="bold" app:drawableStartCompat="@drawable/ic_warning" app:drawableTint="@color/io_warning_text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_taxi" style="@style/Widget.IoTelito.Button.Outline" android:layout_width="wrap_content" android:layout_height="42dp" android:minWidth="0dp" android:text="@string/hoteladmin_ver_taxi" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_detalle" style="@style/Widget.IoTelito.Button.Outline" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:text="@string/hoteladmin_ver_detalle" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_checkout" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:text="@string/hoteladmin_realizar_checkout" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
