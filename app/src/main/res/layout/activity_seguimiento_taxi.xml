<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/io_background">
    <include android:id="@+id/sub_header" layout="@layout/item_sub_header"/>
    <org.osmdroid.views.MapView android:id="@+id/taxi_map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:text="@string/taxi_api_attribution" android:textSize="11sp" android:textColor="@color/io_text_secondary"/>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.IoTelito.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" app:cardCornerRadius="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/taxi_map_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/taxi_api_wait_location" android:textColor="@color/io_navy" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_ver_qr" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/taxi_api_qr"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/taxi_map_rate" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/taxi_api_rating"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/taxi_map_chat" style="@style/Widget.IoTelito.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/taxi_chat_conductor" android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
