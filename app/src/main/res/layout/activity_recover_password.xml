<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/io_background"
    android:orientation="vertical">

    <include
        android:id="@+id/sub_header"
        layout="@layout/item_sub_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recover_subtitle"
            android:textColor="@color/io_text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/TextAppearance.IoTelito.FieldLabel"
            android:layout_marginTop="24dp"
            android:text="@string/login_email"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/recover_email_layout"
            style="@style/Widget.IoTelito.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recover_email_edit_text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enviar_recuperacion"
            style="@style/Widget.IoTelito.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/recover_button" />
    </LinearLayout>
</LinearLayout>
