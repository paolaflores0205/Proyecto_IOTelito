<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Proyecto_IOTelito" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/io_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/io_text_primary</item>
        <item name="android:windowBackground">@color/io_background</item>
        <item name="android:statusBarColor">@color/io_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Proyecto_IOTelito" parent="Base.Theme.Proyecto_IOTelito" />

    <!-- Botón principal: píldora teal -->
    <style name="Widget.IoTelito.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/io_teal</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Botón secundario: contorno teal -->
    <style name="Widget.IoTelito.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/io_teal</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/io_teal</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.IoTelito.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/io_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/io_divider</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.IoTelito.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/io_surface</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/io_teal</item>
    </style>
</resources>
