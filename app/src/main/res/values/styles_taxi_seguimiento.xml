<resources>
    <style name="TaxiTrackingLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/io_text_secondary</item>
    </style>
    <style name="TaxiTrackingValue" parent="TaxiTrackingLabel">
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/io_navy</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TaxiTrackingStep">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/io_text_secondary</item>
        <item name="android:drawableTop">@drawable/ic_check_circle</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
</resources>
