<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".IoTelitoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proyecto_IOTelito">
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RolePreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.booking.ResultadosActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.hoteles.ListaHotelesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.booking.DetalleHotelActivity"
            android:exported="false"
            android:parentActivityName=".ui.booking.ResultadosActivity" />

        <activity
            android:name=".ui.booking.DetalleHabitacionActivity"
            android:exported="false"
            android:parentActivityName=".ui.booking.DetalleHotelActivity" />

        <activity
            android:name=".ui.booking.ConfirmacionReservaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.booking.DetalleHabitacionActivity" />

        <activity
            android:name=".ui.booking.ReservaConfirmadaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservas.DetalleReservaActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.reservas.ChatHotelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.reservas.DetalleReservaActivity" />

        <activity
            android:name=".ui.pago.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.reservas.DetalleReservaActivity" />

        <activity
            android:name=".ui.pago.CobroConfirmadoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.perfil.EditarPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.perfil.NotificacionesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Flujo taxi cliente -->
        <activity
            android:name=".ui.taxi.BeneficioTaxiActivity"
            android:exported="false" />

        <activity
            android:name=".ui.taxi.SolicitudTaxiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.taxi.TaxistaAsignadoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.taxi.SeguimientoTaxiActivity"
            android:exported="false" />

        <activity
            android:name=".ui.taxi.CodigoQrTaxiActivity"
            android:exported="false" />

        <activity
            android:name=".ui.taxi.CalificarTaxiActivity"
            android:exported="false" />

        <!-- Rol Taxista -->
        <activity
            android:name=".ui.taxista.TaxistaMainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.taxista.DetalleServicioActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.TaxistaMainActivity" />

        <activity
            android:name=".ui.taxista.EditarFotoTaxistaActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.TaxistaMainActivity" />

        <activity
            android:name=".ui.taxista.ChatPasajeroTaxistaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.taxista.TaxistaMainActivity" />

        <activity
            android:name=".ui.taxista.ServicioAsignadoActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.DetalleServicioActivity" />

        <activity
            android:name=".ui.taxista.DireccionHotelActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.ServicioAsignadoActivity" />

        <activity
            android:name=".ui.taxista.DireccionAeropuertoActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.DireccionHotelActivity" />

        <activity
            android:name=".ui.taxista.FinalizarServicioActivity"
            android:exported="false"
            android:parentActivityName=".ui.taxista.DireccionAeropuertoActivity" />

        <activity
            android:name=".ui.taxista.ServicioFinalizadoActivity"
            android:exported="false" />

        <!-- Superadmin -->
        <activity
            android:name=".ui.superadmin.SuperadminMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.superadmin.usuarios.DetalleUsuarioActivity"
            android:exported="false"
            android:parentActivityName=".ui.superadmin.SuperadminMainActivity" />

        <activity
            android:name=".ui.superadmin.hoteles.FormularioHotelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.superadmin.SuperadminMainActivity" />

        <activity
            android:name=".ui.superadmin.hoteles.DetalleHotelAdminActivity"
            android:exported="false"
            android:parentActivityName=".ui.superadmin.SuperadminMainActivity" />

        <activity
            android:name=".ui.superadmin.hoteles.AsignarAdministradorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.superadmin.hoteles.DetalleHotelAdminActivity" />

        <activity
            android:name=".ui.superadmin.logs.RegistroLogsActivity"
            android:exported="false"
            android:parentActivityName=".ui.superadmin.SuperadminMainActivity" />

        <!-- Panel de Administrador de hotel (rol HOTEL_ADMIN). Se abre desde el login por rol. -->
        <activity
            android:name=".ui.hoteladmin.HotelAdminMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.hoteladmin.hotel.HabitacionesActivity"
            android:exported="false"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />

        <activity
            android:name=".ui.hoteladmin.hotel.FormularioHabitacionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.hoteladmin.hotel.HabitacionesActivity" />

        <activity
            android:name=".ui.hoteladmin.hotel.ServiciosActivity"
            android:exported="false"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />

        <activity
            android:name=".ui.hoteladmin.hotel.FormularioServicioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.hoteladmin.hotel.ServiciosActivity" />

        <activity
            android:name=".ui.hoteladmin.hotel.DatosHotelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />

        <activity
            android:name=".ui.hoteladmin.hotel.FotosHotelActivity"
            android:exported="false"
            android:parentActivityName=".ui.hoteladmin.hotel.DatosHotelActivity" />

        <activity
            android:name=".ui.hoteladmin.reservas.CobroCheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />

        <activity
            android:name=".ui.hoteladmin.reservas.EstadoTaxiActivity"
            android:exported="false"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />

        <activity
            android:name=".ui.hoteladmin.mensajes.AdminChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.hoteladmin.HotelAdminMainActivity" />
    </application>

</manifest>
