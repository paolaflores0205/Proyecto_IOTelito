<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proyecto_IOTelito">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.booking.ResultadosActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.hoteles.ListaHotelesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.booking.DetalleHotelActivity"
            android:exported="false"
            android:parentActivityName=".ui.booking.ResultadosActivity" />

        <activity
            android:name=".ui.booking.DetalleHabitacionActivity"
            android:exported="false"
            android:parentActivityName=".ui.booking.DetalleHotelActivity" />

        <activity
            android:name=".ui.booking.ConfirmacionReservaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.booking.DetalleHabitacionActivity" />

        <activity
            android:name=".ui.booking.ReservaConfirmadaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservas.DetalleReservaActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.reservas.ChatHotelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.reservas.DetalleReservaActivity" />

        <activity
            android:name=".ui.pago.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.reservas.DetalleReservaActivity" />

        <activity
            android:name=".ui.pago.CobroConfirmadoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.perfil.EditarPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.perfil.NotificacionesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>